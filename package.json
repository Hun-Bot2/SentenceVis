{
  "name": "sentenscope",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/checks/boundaries.mjs",
    "check:docs": "node scripts/checks/docs.mjs",
    "check": "npm run typecheck && npm run check:boundaries && npm run check:docs",
    "test": "node --test tests/unit/*.test.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "d3": "7.9.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
